# ============================================================
# MarxLen 配置文件模板
#
# 使用方法：把本文件复制为 rag/.env，填好下面两个密钥即可。
#   Windows:  copy rag\.env.example rag\.env
#   Linux:    cp rag/.env.example rag/.env
#
# .env 不会被提交到仓库，密钥只保存在你自己的电脑上。
# 大部分参数（模型、温度、缓存等）在设置页就能改，无需动这个文件。
# ============================================================


# ============================================================
# 必填：两个密钥
# ============================================================

# 【1】对话模型密钥 —— 负责生成回答
# 申请地址：https://platform.deepseek.com/
OPENAI_API_KEY=sk-your-api-key

# 【2】检索密钥 —— 一个 key 同时负责「向量检索」和「结果重排」
# 申请地址：https://siliconflow.cn/（免费注册，新用户送额度）
EMBED_API_KEY=sk-your-embedding-api-key


# ============================================================
# 可选：按需修改
# ============================================================

# 对话模型 ID（默认 deepseek-chat，可在设置页切换）
# OPENAI_MODEL=deepseek-chat

# 对话模型服务地址（换服务商时改，默认 DeepSeek）
# OPENAI_API_BASE_URL=https://api.deepseek.com/v1

# 设置页下拉可选模型，格式：id1:显示名1,id2:显示名2
# OPENAI_MODEL_LIST=deepseek-chat:DeepSeek-V3

# 检索服务地址（默认硅基流动，免费注册即可用，通常不用改）
# EMBED_API_BASE_URL=https://api.siliconflow.cn/v1

# 前置分析模型 —— 检索前把问题解构成检索计划，安装时必填，默认值即可用
PLANNER_MODEL=deepseek-chat

# 嵌入模型（必须保持默认！索引由它生成，换掉会导致检索完全错乱）
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# 重排模型
# RERANK_MODEL=Qwen/Qwen3-Reranker-4B
