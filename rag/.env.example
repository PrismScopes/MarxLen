# ===== 大模型 (Generator) API 配置 =====
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
# 可选：设置页面的模型下拉列表（格式：id1:显示名1,id2:显示名2）
# DEEPSEEK_MODEL_LIST=deepseek-chat:DeepSeek-V3,deepseek-reasoner:DeepSeek-R1,deepseek-v4-pro:DeepSeek-V4-Pro

# ===== Rerank API 配置 =====
EMBED_API_BASE_URL=https://your-api-endpoint.example.com/v1
RERANK_API_KEY=sk-your-rerank-api-key
# RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# ===== 检索调优 =====
# RERANK_TIMEOUT=30
# SCORE_THRESHOLD=0.0
